{
  "name": "token-acl-gate",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "",
    "build:program": "cargo build-sbf --manifest-path=program/Cargo.toml",
    "test": "cargo test --manifest-path=sdk/rust/Cargo.toml",
    "build:cli": "cargo build --manifest-path=cli/Cargo.toml",
    "generate-sdks": "node -r tsx/cjs codama-generate-clients.ts",
    "generate-idl": "cd program && cargo check --features idl && cd .. && node -r tsx/cjs codama-fix-idl.ts",
    "copy:test:fixtures": "cp target/deploy/token_acl_gate_program.so sdk/rust/tests/fixtures/"
  },
  "dependencies": {
    "@codama/nodes": "^1.5.1",
    "@codama/renderers": "^1.0.34",
    "@codama/renderers-js": "1.4.3",
    "@codama/renderers-rust": "1.2.7",
    "@codama/visitors": "^1.5.1",
    "@types/mocha": "^10.0.10",
    "codama": "^1.5.1",
    "litesvm": "^0.2.0",
    "mocha": "^11.1.0",
    "solana-bankrun": "^0.4.0",
    "tsx": "^4.19.3",
    "zx": "^8.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29"
  },
  "packageManager": "pnpm@10.20.0"
}
